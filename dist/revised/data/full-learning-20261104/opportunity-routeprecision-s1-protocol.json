9afde16c84bc0031e7af96ee3b48829a9e3196360ab0155369e5dceade3619a6","src/voi_diffusion_ipp/quarter/continuous.py":"54e69b0eb488e84d1ddada007f3aefa8d44c41d993121132eacdd47b956c616e","src/voi_diffusion_ipp/quarter/rrt.py":"ff8e3ca5fb8031aeaa19b585680df425eff2da29500b4a3bacb6f9bf3d8cd238","src/voi_diffusion_ipp/baselines/__init__.py":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","src/voi_diffusion_ipp/baselines/draft.py":"ad48de7e2dffc63b1f85644cb72eda16827c9067f45909e3c6f65d792d8c1eb1"},"initial_measurements":0,"prelearned_source":null,"prelearned_scope":null,"gp_profile":{"inducing_count":768,"lengths_m":[0.2,0.5,1.0,2.0],"prior_std_m_s":1.8,"observation_std_m_s":0.1,"training_batch_size":256,"amplitude_learning_rate":0.01},"cache_spacing_m":0.1,"prior_support_count":2607,"learning_policy":"mask","task_std_threshold_m_s":0.2,"efficient_planning":true,"model_trust":true,"adaptive_learning":true,"information_trigger":"lower-cost","learning_controller":"reachable-waypoints","frontier_prefixes":false,"learning_replan_seconds":5.0,"global_information_goals":true,"factorized_support":true,"prefix_screen":"braking-feasible","learned_route_bounds":true,"diversify_stalled_routes":true,"route_precision_handoff":true,"information_path_definition":null,"targeted_handoff":"Task-weighted vector posterior RMS uncertainty <= threshold; no true wind in decision. Mask uses exact no-sensing clarity deficit; correlated uses one-observation integrated posterior variance reduction; routes uses geometric route occupancy and expected squared aerodynamic Jacobian. These are bounded acquisition heuristics, not exact monitoring value of information.","survey_seconds":300,"total_seconds":300,"policy":"Choose persistent global information goals over the existing mean-wind compensation graph, using full GP integrated-variance reduction and geometric distance. Unknown prior-mean wind is zero for this goal-routing screen; covariance is not suppressed. Advance only along a prefix supported by the current 3-sigma holding and braking bounds, re-evaluated after each actual .2s measurement. Learned mean wind can exclude a passage and change the geometric route. Retain shared recovery, physical dynamics, full execution RPCBF and downstream 15s MBD. No assumed future observations or altered posterior. Retire a learned target at per-component variance <= half the squared declared vector-precision threshold; proximity alone does not establish learning. Check progress over successive 15s windows. Prefix screen: explicitly test existence of a bounded at-rest control satisfying all robust circle/wall braking inequalities with 75% actuator authority. This replaces the stronger sufficient zero-residual-control holding test for geometry only. Actual moving-state RPCBF is unchanged. Recompute geometric connectivity using the same nonlinear 3-sigma actuator-reserve bound that triggers recovery, applied within 0.15 m of actual sensor positions. Unmeasured nodes retain the existing mean-wind routing assumption. This explicit geometric support radius is not a sensor footprint, observation, uncertainty reset or physical obstacle. Safety retains full uncertainty everywhere. Keep the information goal and progress window across temporary measured-path recovery. On less than 0.30 m net geometric progress over a 15 s window, search another passage to the SAME information goal using the existing geometry-derived temporary bottleneck cuts. Retain the cut until goal completion or abandonment. These cuts diversify references only; they never change the physical environment, belief or execution safety constraints.","handoff":"Separate route-precision diagnostic: RMS vector posterior uncertainty <= 0.20 m/s on unique 0.05 m initialization-grid cells intersected by the actually traversed polyline AND the full remaining geometric path to the selected information goal. Repeated visits do not duplicate cell weights. Use the same full-posterior C1 uncertainty field as execution. Freeze a qualifying route domain and recheck it using the latest posterior at handoff. This finite route domain is a declared stopping proxy, not a whole-map accuracy certificate or a replacement monitoring objective. MBD and RPCBF retain the unmodified full spatial posterior. No true error enters this gate.","rmse_threshold_m_s":0.2,"rmse_domain":"All collision-free grid cells, vector error norm","learning_limit_s":300,"mbd":"Original independent MBD chains, 15s, 43 search evaluations; cached existing mode-leader scores, same two finalists batched for validation. Unattenuated POAM posterior, 2 training and 2 independent validation fields; optimized alternate mode leader validated.","safety":"Full-posterior RPCBF plus robust relative-degree-two wall AND circular-obstacle braking constraints, rate 1.5/s; exact distance Hessian and nonlinear force support; hard QP, logged minimum-slack fallback; no global guarantee.","sensor_period_s":0.2,"control_period_s":0.05,"integration_period_s":0.01,"waypoint_replan_s":0.2,"prior_std_m_s":1.8,"noise_std_m_s":0.1,"inducing":768,"inducing_allocation":"Original POAM pivoted Cholesky over old inducing points plus actual new measurement positions; exact permutation transport for unchanged point sets.","kernel_training":"Four independent 256-row history minibatches every 50 actual readings; first at t=9.8s. Per-measurement conditioning; no temporal wind model.","truth_access":"Plant, actual local noisy sensor, displayed RMSE and phase-gate boolean; never planner or controller","device":"[CpuDevice(id=0)]","model_support":"Additional finalist-admissibility test, not altered physics or an extra monitoring objective. Keep the original 43 MBD training evaluations and independent chains. Among their already-evaluated archive members, choose the two lowest-cost distinct references with nonlinear wind acceleration-error bound k(2||mu-v||R+R^2) <= 0.4 m/s^2 throughout the nominal reference, R=3sqrt(sigma^2+0.1^2). Recheck this bound at every 0.05 s predicted state in both full hard-RPCBF validation rollouts. Additionally require ||u||_infinity + error_bound <= 1.6 m/s^2 at every predicted control step, and the same condition for nominal wind-compensated references. The 0.4 cap is the existing 25 percent actuator-reserve scale; the explicit headroom inequality checks that this authority remains available. Hold fallback remains explicit. This finite-grid model-support condition is conditional on posterior calibration, not a global safety certificate. No posterior attenuation, true wind or synthetic readings.","adaptive_information":"After the initial route gate, keep the same five-second MBD request cadence. Resume the existing filtered sensing policy when an uncertainty-blocked reference has lower training cost by more than 1e-4 on the SAME wind fields and the accepted forecast moves less than one sensor sigma, or no finalist is valid. Exclude references already infeasible under mean-wind compensation from this information trigger. Rank actual waypoint measurements by full-GP expected variance reduction along the blocked reference, weighted by no-sensing clarity deficit through the physical sensing footprint and exact expected squared aerodynamic Jacobian. This is a bounded acquisition proxy, not exact long-term value of information. A 0.25 m tube is used only to shortlist 32 geometric measurement candidates; GP information gain is evaluated directly at the reference positions. Persist in a measurement goal across replanning/recovery. Return to MBD execution when the next request no longer triggers this condition. Actual measurements only; no simulated observation enters POAM. Revised opportunity criterion: movement within the current region does not suppress learning. Any lower-cost uncertainty-blocked reference can request measurements, provided all its nominal reference positions clear physical obstacles/walls by the existing safety margin and mean wind compensation is feasible. This finite reference screen only selects information queries; the executed measurement path still comes from the unchanged geometric graph and full RPCBF. Retain persistent information goals, progress windows and temporary passage cuts across MBD probes. Reconstruct recovery history from actual sensor positions. Compile all validation-count branches during the first explicitly timed startup request; the actual evaluated candidates and wind draws are unchanged."}